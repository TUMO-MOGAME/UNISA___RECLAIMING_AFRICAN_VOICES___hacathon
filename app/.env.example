# Maloba — environment variables. Copy to `app/.env` (gitignored) and fill in.
# Only PUBLIC / anon keys belong here — EXPO_PUBLIC_* vars are bundled into the client.
# See docs/02-tech-stack.md.

# Google Gemini (free — Google AI Studio). Used at AUTHOR time to draft Child/translation text.
EXPO_PUBLIC_GEMINI_API_KEY=

# Lelapa AI / Vulavula (trial) — indigenous-language transcription/translation (Community Archive).
EXPO_PUBLIC_LELAPA_API_KEY=

# Supabase (free tier) — cloud archive. Anon key is safe ONLY with Row-Level Security enabled.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Botlhale AI (via contact) — indigenous-language neural Text-to-Speech for the Reader's "Listen"
# button. When unset, the app falls back to free on-device speech automatically (still works offline).
# API_KEY holds a Bearer *IdToken* (Botlhale exchanges a refresh_token -> IdToken; ask the contact
# for a ready token for the demo). BASE_URL is optional: default https://api.botlhale.xyz — set it to
# https://api-dev.botlhale.xyz if the contact points you at the dev host.
EXPO_PUBLIC_BOTLHALE_API_KEY=
EXPO_PUBLIC_BOTLHALE_BASE_URL=
# ORG_ID is needed for the translation API (used offline by `npm run gen:drafts` to pre-generate
# machine-draft translations for the 9 not-yet-reviewed SA languages). Ask the contact for it.
EXPO_PUBLIC_BOTLHALE_ORG_ID=

# Pollinations.ai needs NO key.
# ElevenLabs is used OFFLINE to pre-render the intro narration — never called at runtime.
